{
  "name": "laptop-review-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "npm run seed && next dev",
    "build": "npm run seed && next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "test:unit": "npm run seed && tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.5"
  }
}
